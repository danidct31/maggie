generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String
  priceCents   Int
  category     String
  imageUrl     String
  sizes        String[]
  featured     Boolean  @default(false)
  /// studio = sold by Maggie; amazon = shown here, paid on Amazon
  fulfillment  String   @default("studio")
  /// Amazon ASIN when fulfillment is amazon (PENDING-* until shop exists)
  amazonAsin   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
